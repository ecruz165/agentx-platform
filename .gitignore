# Dependencies
node_modules/
.screenshots/
# OS
.DS_Store
Thumbs.db

# Logs
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*
.pnpm-debug.log*

# Editor swap / temp files
*.swp
*.swo
*~

# Sockets
*.sock

# Build output
dist/
build/
out/
*.tsbuildinfo

# Test / coverage
coverage/
.nyc_output/

# Caches
.cache/
.turbo/
.parcel-cache/
.eslintcache

# Env / secrets
.env
.env.local
.env.*.local

# Per-user host-side files (auth.json lives at ~/.agentx/auth.json, never in repo)
/host/auth.json

# Repo-root workspace runtime state — purely test/dev artifacts produced when
# running examples from the repo root. Default-deny: nothing under /.harness/
# is committed, including any config/catalog generated by a test run.
/.harness/

# Spring Boot Modulith control plane (Java/Maven sub-project)
/controlplane/target/
/controlplane/.mvn/wrapper/maven-wrapper.jar
/controlplane/HELP.md
/controlplane/.idea/
/controlplane/*.iml

# Workspace-template runtime state (gitkeep'd structure preserved; runtime files ignored)
/workspace-template/.harness/run/*
!/workspace-template/.harness/run/.gitkeep
/workspace-template/.harness/wt/*
!/workspace-template/.harness/wt/.gitkeep
/workspace-template/.harness/captures/*
!/workspace-template/.harness/captures/.gitkeep
/workspace-template/.harness/repos/*
!/workspace-template/.harness/repos/.gitkeep
