{
  "name": "agentx",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@9.12.0",
  "scripts": {
    "typecheck": "pnpm -r typecheck",
    "test": "vitest run",
    "test:watch": "vitest",
    "format": "biome format --write .",
    "lint": "biome lint .",
    "check": "biome check .",
    "check:fix": "biome check --write .",
    "changeset": "changeset",
    "changeset:status": "changeset status --since=develop",
    "changeset:version": "changeset version",
    "changeset:publish": "changeset publish",
    "host-only": "tsx examples/01-host-only.ts",
    "opencode-only": "tsx examples/02-opencode-host-only.ts",
    "roundtrip": "tsx examples/03-uds-roundtrip.ts",
    "dev:servers": "tsx examples/04-server-trio.ts",
    "dev:propagation-demo": "tsx examples/05-auth-propagation-demo.ts",
    "dev:skill-demo": "tsx examples/06-agent-skill-demo.ts",
    "dev:per-skill-demo": "tsx examples/07-per-skill-demo.ts",
    "dev:submit-demo": "tsx examples/08-job-submit-demo.ts",
    "dev:worker-demo": "tsx examples/09-worker-spawn-demo.ts",
    "dev:events-demo": "tsx examples/10-job-events-demo.ts",
    "dev:orchestrator-demo": "tsx examples/11-orchestrated-pipeline-demo.ts",
    "dev:in-process": "tsx examples/12-in-process-cli-demo.ts",
    "harness:run": "bun packages/harness-cli/src/in-process-run.tsx",
    "verify": "tsx examples/verify-no-leak.ts",
    "harness": "bun packages/harness-cli/src/index.ts",
    "agentx-workspace": "bun packages/workspace-cli/src/bin.tsx",
    "tui": "pnpm --silent harness tui",
    "tmux": "scripts/dev-tmux.sh",
    "tmux:down": "tmux kill-session -t ${AGENTX_TMUX_SESSION:-agentx} 2>/dev/null || true",
    "tmux:reset": "scripts/tmux-reset.sh"
  },
  "dependencies": {
    "@ecruz165/agent-adapter": "workspace:*",
    "@ecruz165/agent-auth": "workspace:*",
    "@ecruz165/edge-context-server": "workspace:*",
    "@ecruz165/edge-memory-server": "workspace:*",
    "@ecruz165/harness": "workspace:*",
    "@ecruz165/harness-core": "workspace:*",
    "@ecruz165/harness-pipeline": "workspace:*",
    "@ecruz165/harness-server": "workspace:*"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.4.14",
    "@changesets/cli": "^2.31.0",
    "@types/node": "^22.7.0",
    "tsup": "^8.5.1",
    "tsx": "^4.19.0",
    "typescript": "^5.6.0",
    "vitest": "^4.1.5",
    "yaml": "^2.6.0"
  },
  "pnpm": {
    "overrides": {
      "react": "19.2.6",
      "react-dom": "19.2.6"
    }
  }
}
